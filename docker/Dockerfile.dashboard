# Dashboard image: Streamlit only. It reads everything through the API, so it needs no
# models or warehouse, just the evaluation charts for the Model Performance tab.
#
#   docker build -t consumer-telemetry-dashboard -f docker/Dockerfile.dashboard .
#   docker run -p 8501:8501 -e CT_API_URL=http://host.docker.internal:8000 consumer-telemetry-dashboard

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PORT=8501

RUN useradd --create-home --uid 1000 app
WORKDIR /app

COPY src/dashboard/requirements.txt /tmp/requirements.txt
RUN pip install -r /tmp/requirements.txt

COPY --chown=app:app src/__init__.py src/__init__.py
COPY --chown=app:app src/dashboard/ src/dashboard/
COPY --chown=app:app src/models/artifacts/*.png src/models/artifacts/*.json src/models/artifacts/

USER app
EXPOSE 8501

CMD ["sh", "-c", "streamlit run src/dashboard/app.py --server.port ${PORT} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
